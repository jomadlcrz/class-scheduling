{
  "$schema": "https://unpkg.com/knip@5/overview/config.json",
  "entry": [
    "app/routes/**/*.{ts,tsx}"
  ],
  "project": [
    "app/**/*.{ts,tsx}"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "tailwindcss"
  ],
  "rules": {
    "files": "warn",
    "types": "warn",
    "exports": "warn",
    "duplicates": "error"
  }
}
